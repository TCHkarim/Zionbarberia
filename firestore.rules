rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && request.auth.token.email == 'TU_CORREO_ADMIN@gmail.com'; }
    match /settings/{id} { allow read: if true; allow write: if admin(); }
    // Horarios ocupados: públicos y solo se pueden crear (si ya existe, falla: evita doble reserva)
    match /slots/{id} { allow read: if true; allow create: if request.resource.data.keys().hasOnly(['date','time','aid']); allow delete: if admin(); }
    match /appointments/{id} {
      allow create: if request.resource.data.status == 'pendiente' && request.resource.data.name is string && request.resource.data.name.size() < 80;
      allow read, update, delete: if admin();
    }
  }
}
